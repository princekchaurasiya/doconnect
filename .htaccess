RewriteEngine On
RewriteBase /doconnect/

# Handle Dynamic Location Pages (e.g., "andheri.php" → "location.php?slug=andheri")
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)\.php$ location.php?slug=$1 [L,QSA]

# Custom 404 Error Page (Must come after handling dynamic pages)
ErrorDocument 404 /doconnect/404.php

# Block Direct Access to Sensitive Backend Files
<FilesMatch "^(db-connect\.php|admin-middleware\.php|generate-slugs\.php|log_test\.php|test-db\.php|manage-categories\.php|create-admin\.php)$">
    Require all denied
</FilesMatch>

# Prevent Indexing of Sensitive Files
<FilesMatch "^(admin\.php|manage-categories\.php|add-post\.php|edit-post\.php|admin-middleware\.php|create-admin\.php|db-connect\.php|generate-slugs\.php|log_test\.php|login\.php|logout\.php|offline\.php|test-db\.php)$">
    Header set X-Robots-Tag "noindex, nofollow"
</FilesMatch>

# Disable Directory Listing for Security
Options -Indexes

# Test Rewrite Rule
RewriteRule ^test-rewrite$ test.php [L]
